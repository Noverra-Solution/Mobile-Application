{
  "expo": {
    "name": "Noverra",
    "slug": "noverra-mobile",
    "scheme": "noverra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070B",
    "splash": {
      "image": "./assets/nexus-hero-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070B"
    },
    "icon": "./assets/nexus-emblem.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.novera.facilities"
    },
    "plugins": [
      "expo-status-bar",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "b475a076-3111-4d03-9381-aefb001114e5"
      }
    }
  }
}
